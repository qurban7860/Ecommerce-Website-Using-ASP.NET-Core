@model List<CartItem>
@{ ViewData["Title"] = "Shopping Cart"; var total = Model.Sum(x => x.Total); }
<h1>Your shopping cart</h1>
@if (!Model.Any())
{
    <div class="empty-state"><p>Your cart is empty.</p><a asp-controller="Products" asp-action="Index">Browse products</a></div>
}
else
{
    <div class="cart-list">
    @foreach (var item in Model)
    {
        <article class="cart-item">
            <img src="@item.ImageUrl" alt="@item.Name" />
            <div class="cart-description"><h3>@item.Name</h3><p>$@item.Price.ToString("0.00") × @item.Quantity</p></div>
            <strong>$@item.Total.ToString("0.00")</strong>
            <form asp-action="Remove" method="post"><input type="hidden" name="productId" value="@item.ProductId" /><button class="button-danger" type="submit">Remove</button></form>
        </article>
    }
    </div>
    <div class="cart-total"><h2>Total: $@total.ToString("0.00")</h2><form asp-action="Clear" method="post"><button class="button-secondary" type="submit">Clear cart</button></form></div>
    <p class="muted">Checkout and payment processing are not included in this starter project.</p>
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Simple Store</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="brand" asp-controller="Products" asp-action="Index">Simple Store</a>
        <nav><a asp-controller="Products" asp-action="Index">Products</a><a asp-controller="Cart" asp-action="Index">Shopping Cart</a></nav>
    </header>
    <main class="container">@RenderBody()</main>
    <footer>Simple Store · ASP.NET Core MVC demo</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
